[Unit]
Description=Argon ONE V5 Legacy OLED Display and Button Service (Fast C Edition)
After=multi-user.target

[Service]
Type=simple
Restart=always
RestartSec=2
ExecStart=/usr/bin/argon-1v5-oled-legacy SERVICE OLEDSWITCH
ExecStop=/usr/bin/argon-1v5-oled-legacy SHUTDOWN

[Install]
WantedBy=multi-user.target
