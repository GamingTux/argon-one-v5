#!/bin/bash
set -e

if [ -e /boot/firmware/config.txt ]; then
    CONFIG="/boot/firmware/config.txt"
else
    CONFIG="/boot/config.txt"
fi

# 1. Enable I2C in config.txt (required for the OLED display at 0x3C)
if [ -f "$CONFIG" ]; then
    if grep -q "^#dtparam=i2c_arm=on" "$CONFIG"; then
        sed -i 's/^#dtparam=i2c_arm=on/dtparam=i2c_arm=on/' "$CONFIG"
    elif ! grep -q "^dtparam=i2c_arm=on" "$CONFIG"; then
        last_sec=$(grep "^\[.*\]" "$CONFIG" | tail -n 1 || true)
        if [ "$last_sec" != "[all]" ]; then
            echo "" >> "$CONFIG"
            echo "[all]" >> "$CONFIG"
        fi
        echo "dtparam=i2c_arm=on" >> "$CONFIG"
    fi
fi

# 2. Ensure i2c-dev kernel module is loaded on boot and immediately at runtime (no reboot needed for OLED!)
mkdir -p /etc/modules-load.d
echo "i2c-dev" > /etc/modules-load.d/argon-i2c.conf
if [ -f /etc/modules ] && ! grep -q "^i2c-dev" /etc/modules; then
    echo "i2c-dev" >> /etc/modules
fi

if command -v raspi-config >/dev/null 2>&1; then
    raspi-config nonint do_i2c 0 2>/dev/null || true
fi
if command -v dtparam >/dev/null 2>&1; then
    dtparam i2c_arm=on 2>/dev/null || true
fi
modprobe i2c_bcm2835 2>/dev/null || true
modprobe i2c_designware_platform 2>/dev/null || true
modprobe i2c-dev 2>/dev/null || true

# 3. Install default OLED config if not present
if [ ! -f /etc/argononeoled.conf ]; then
    cat << 'EOF' > /etc/argononeoled.conf
#
# Argon ONE V5 Legacy OLED Configuration
#
enabled=Y
switchduration=10
screensaver=120
refreshinterval=1
screenlist="clock cpu storage ram temp ip"
EOF
fi

# 4. Install original .bin assets to /etc/argon/oled if not present & clean up unused fonts
mkdir -p /etc/argon/oled
rm -f /etc/argon/oled/font16x12.bin /etc/argon/oled/font24x16.bin /etc/argon/oled/font32x24.bin /etc/argon/oled/font48x32.bin /etc/argon/oled/font64x48.bin
rm -f /dev/shm/argon_button_debug.log /dev/shm/argonshutdownflag.txt /dev/shm/argon_oled_fb.bin
if [ -d /usr/share/argon-1v5-oled-legacy/oled ]; then
    for f in /usr/share/argon-1v5-oled-legacy/oled/*.bin; do
        [ -e "$f" ] || continue
        base=$(basename "$f")
        if [ ! -f "/etc/argon/oled/$base" ]; then
            cp "$f" "/etc/argon/oled/$base"
        fi
    done
fi

# 5. Stop conflicting OLED services so only one daemon accesses I2C 0x3C and GPIO4
for svc in argon-v5-oled.service argononed.service; do
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
        systemctl stop "$svc" || true
    fi
    if systemctl is-enabled --quiet "$svc" 2>/dev/null; then
        systemctl disable "$svc" || true
    fi
done

systemctl daemon-reload
systemctl enable argon-1v5-oled-legacy.service
systemctl restart argon-1v5-oled-legacy.service || true

echo "argon-1v5-oled-legacy service enabled and started successfully."
exit 0
