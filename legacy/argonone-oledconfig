#!/bin/bash

if [ "$(id -u)" -ne 0 ]; then
	exec sudo "$0" "$@"
fi

oledconfigfile=/etc/argononeoled.conf
eonconfigfile=/etc/argoneonoled.conf

get_number () {
	read -r curnumber
	if [ -z "$curnumber" ]
	then
		echo "-2"
		return
	elif [[ $curnumber =~ ^[+-]?[0-9]+$ ]]
	then
		if [ "$curnumber" -lt 0 ]
		then
			echo "-1"
			return
		elif [ "$curnumber" -gt 3600 ]
		then
			echo "-1"
			return
		fi
		echo "$curnumber"
		return
	fi
	echo "-1"
	return
}

get_pagename() {
	if [ "$1" == "clock" ]
	then
		pagename="Current Date/Time"
	elif [ "$1" == "cpu" ]
	then
		pagename="CPU Utilization"
	elif [ "$1" == "storage" ]
	then
		pagename="Storage Utilization"
	elif [ "$1" == "raid" ]
	then
		pagename="RAID Utilization"
	elif [ "$1" == "ram" ]
	then
		pagename="Available RAM"
	elif [ "$1" == "temp" ]
	then
		pagename="CPU Temperature"
	elif [ "$1" == "ip" ]
	then
		pagename="IP Address"
	elif [ "$1" == "logo1v5" ]
	then
		pagename="Logo:One v5"
	else
		pagename="Invalid"
	fi
}

configure_pagelist () {
	pagemasterlist="logo1v5 clock cpu storage raid ram temp ip"
	newscreenlist="$1"
	pageloopflag=1
	while [ $pageloopflag -eq 1 ]
	do
		echo "--------------------------------"
		echo " OLED Pages "
		echo "--------------------------------"
		i=1
		for curpage in $newscreenlist
		do
			get_pagename "$curpage"
			echo "  $i. Remove $pagename"
			i=$((i+1))
		done
		if [ $i -eq 1 ]
		then
			echo " No page configured"
		fi
		echo
		echo "  $i. Add Page"
		echo
		echo "  0. Done"
		echo -n "Enter Number (0-$i):"

		cmdmode=$( get_number )
		if [ "$cmdmode" -eq 0 ]
		then
			pageloopflag=0
		elif [[ $cmdmode -eq $i ]]
		then
			echo "--------------------------------"
			echo " Choose Page to Add"
			echo "--------------------------------"
			echo
			i=1
			for curpage in $pagemasterlist
			do
				get_pagename "$curpage"
				echo "  $i. $pagename"
				i=$((i+1))
			done

			echo
			echo "  0. Cancel"
			echo -n "Enter Number (0-$((i-1))):"
			pagenum=$( get_number )
			if [[ $pagenum -ge 1 && $pagenum -lt $i ]]
			then
				i=1
				for curpage in $pagemasterlist
				do
					if [ $i -eq "$pagenum" ]
					then
						if [ "$newscreenlist" == "" ]
						then
							newscreenlist="$curpage"
						else
							newscreenlist="$newscreenlist $curpage"
						fi
					fi
					i=$((i+1))
				done
			fi
		elif [[ $cmdmode -ge 1 && $cmdmode -lt $i ]]
		then
			tmpscreenlist=""
			i=1
			for curpage in $newscreenlist
			do
				if [ ! $i -eq "$cmdmode" ]
				then
					tmpscreenlist="$tmpscreenlist $curpage"
				fi
				i=$((i+1))
			done
			if [ "$tmpscreenlist" == "" ]
			then
				newscreenlist=""
			else
				newscreenlist="${tmpscreenlist:1}"
			fi
		fi
	done
}

loadconfig_safe () {
	local cfg="$1"
	[ -f "$cfg" ] || return
	local val
	val=$(grep -E '^[[:space:]]*enabled=' "$cfg" | tail -n 1 | cut -d= -f2- | tr -d '"\r\n \t')
	[ -n "$val" ] && enabled="$val"
	val=$(grep -E '^[[:space:]]*switchduration=' "$cfg" | tail -n 1 | cut -d= -f2- | tr -d '"\r\n \t')
	[[ "$val" =~ ^[0-9]+$ ]] && switchduration="$val"
	val=$(grep -E '^[[:space:]]*screensaver=' "$cfg" | tail -n 1 | cut -d= -f2- | tr -d '"\r\n \t')
	[[ "$val" =~ ^[0-9]+$ ]] && screensaver="$val"
	val=$(grep -E '^[[:space:]]*refreshinterval=' "$cfg" | tail -n 1 | cut -d= -f2- | tr -d '"\r\n \t')
	[[ "$val" =~ ^[0-9]+$ ]] && refreshinterval="$val"
	if grep -qE '^[[:space:]]*screenlist=' "$cfg"; then
		val=$(grep -E '^[[:space:]]*screenlist=' "$cfg" | tail -n 1 | cut -d= -f2- | tr -d '"\r\n')
		screenlist="$val"
	fi
}

saveconfig () {
	cat << EOF > "$oledconfigfile"
#
# Argon ONE V5 Legacy OLED Configuration
#
enabled=$1
switchduration=$2
screensaver=$3
refreshinterval=$4
screenlist="$5"
EOF
	chmod 644 "$oledconfigfile"
	if [ -f "$eonconfigfile" ]; then
		cp -f "$oledconfigfile" "$eonconfigfile"
	fi
}

updateconfig=1
oledloopflag=1
while [ $oledloopflag -eq 1 ]
do
	if [ $updateconfig -eq 1 ]
	then
		loadconfig_safe "$oledconfigfile"
	fi

	updateconfig=0
	if [ -z "$enabled" ]; then enabled="Y"; updateconfig=1; fi
	if [ -z "$screenlist" ]; then screenlist="clock cpu storage ram temp ip"; updateconfig=1; fi
	if [ -z "$screensaver" ]; then screensaver=120; updateconfig=1; fi
	if [ -z "$switchduration" ]; then switchduration=10; updateconfig=1; fi
	if [ -z "$refreshinterval" ]; then refreshinterval=1; updateconfig=1; fi

	if [ $updateconfig -eq 1 ]
	then
		saveconfig "$enabled" "$switchduration" "$screensaver" "$refreshinterval" "$screenlist"
		updateconfig=0
	fi

	displaystring=": Manually"
	if [ "$switchduration" -gt 1 ]
	then
		displaystring="Every $switchduration secs"
	fi

	echo "----------------------------------------"
	echo "Argon ONE V5 Legacy OLED Configuration"
	echo "----------------------------------------"
	echo "Choose from the list:"
	echo "  1. Switch Page $displaystring"
	echo "  2. Configure Pages ($screenlist)"
	echo "  3. Turn OFF OLED Screen when unchanged after $screensaver secs"
	echo "  4. Enable OLED Pages: $enabled"
	echo "  5. Live Value Refresh Interval: Every $refreshinterval sec(s)"
	echo
	echo "  0. Exit"
	echo -n "Enter Number (0-5):"

	newmode=$( get_number )
	if [ "$newmode" -eq 0 ]
	then
		oledloopflag=0
	elif [ "$newmode" -eq 1 ]
	then
		echo
		echo -n "Enter # of Seconds (5-60, Manual if 0):"
		cmdmode=$( get_number )
		if [ "$cmdmode" -eq 0 ] || [[ $cmdmode -ge 5 && $cmdmode -le 60 ]]
		then
			switchduration=$cmdmode
			updateconfig=1
		else
			echo "Invalid duration"
		fi
	elif [ "$newmode" -eq 2 ]
	then
		configure_pagelist "$screenlist"
		if [ ! "$screenlist" == "$newscreenlist" ]
		then
			screenlist="$newscreenlist"
			updateconfig=1
		fi
	elif [ "$newmode" -eq 3 ]
	then
		echo
		echo -n "Enter # of Seconds (30 or above, Never if 0):"
		cmdmode=$( get_number )
		if [ "$cmdmode" -eq 0 ] || [ "$cmdmode" -ge 30 ]
		then
			screensaver=$cmdmode
			updateconfig=1
		else
			echo "Invalid duration"
		fi
	elif [ "$newmode" -eq 4 ]
	then
		echo
		echo -n "Enable OLED Pages (Y/n)?:"
		read -r -n 1 confirm
		echo
		if [[ "$confirm" == "n" || "$confirm" == "N" ]]; then
			enabled="N"; updateconfig=1
		elif [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
			enabled="Y"; updateconfig=1
		fi
	elif [ "$newmode" -eq 5 ]
	then
		echo
		echo -n "Enter Live Refresh Interval in Seconds (1-10):"
		cmdmode=$( get_number )
		if [[ $cmdmode -ge 1 && $cmdmode -le 10 ]]
		then
			refreshinterval=$cmdmode
			updateconfig=1
		else
			echo "Invalid interval"
		fi
	fi

	if [ $updateconfig -eq 1 ]
	then
		saveconfig "$enabled" "$switchduration" "$screensaver" "$refreshinterval" "$screenlist"
	fi
done
echo
