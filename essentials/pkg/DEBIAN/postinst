#!/bin/bash
set -e

# Remove any obsolete tuning files from older package versions (<= 1.2.0)
rm -f /etc/sysctl.d/90-argon-v5-perf.conf
rm -f /etc/sysctl.d/99-z-argon-v5-perf.conf
rm -f /etc/udev/rules.d/60-argon-v5-perf.rules
rm -f /etc/systemd/zram-generator.conf.d/90-argon-v5-zram.conf
rm -f /usr/bin/argon-v5-irq-policy
if [ -f /etc/default/irqbalance ] && grep -q "argon-v5-irq-policy" /etc/default/irqbalance; then
    sed -i '/argon-v5-irq-policy/d' /etc/default/irqbalance
fi

if [ -x /usr/bin/argon-v5-essentials ]; then
    /usr/bin/argon-v5-essentials --apply
fi

exit 0
