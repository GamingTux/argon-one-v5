#!/bin/bash
#
# Argon ONE V5 Case Hardware Essentials (v1.3.0)
# Strictly configures the hardware entries required to operate the Argon ONE V5 case
# (works with or without the optional OLED module; zero OS/performance tuning)
#

set -e
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

if [ -e /boot/firmware/config.txt ]; then
    CONFIG="/boot/firmware/config.txt"
else
    CONFIG="/boot/config.txt"
fi

STATE_DIR="/var/lib/argon-v5-essential"

# Check if a config.txt directive is active for Raspberry Pi 5
# (matches lines in the global header, [all], [pi5], or [bcm2712]; ignores [cm4], [cm5], [pi4], etc.)
has_pi5_param() {
    local pattern="$1"
    [ -f "$CONFIG" ] || return 1
    awk -v pat="$pattern" '
        BEGIN { active = 1; found = 0 }
        /^[[:space:]]*#/ { next }
        /^[[:space:]]*\[[^]]+\]/ {
            sec = $0
            gsub(/^[[:space:]]*\[|\][[:space:]]*$/, "", sec)
            sec = tolower(sec)
            if (sec == "all" || sec == "pi5" || sec == "bcm2712") {
                active = 1
            } else {
                active = 0
            }
            next
        }
        active && $0 ~ pat { found = 1; exit 0 }
        END { exit(found ? 0 : 1) }
    ' "$CONFIG"
}

ensure_all_section() {
    # Ensure the last section header in config.txt is [all] so appended lines apply to Pi 5
    if [ -f "$CONFIG" ]; then
        last_sec=$(grep "^[[:space:]]*\[.*\]" "$CONFIG" | tail -n 1 | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]' || true)
        if [ "$last_sec" != "[all]" ]; then
            echo "" >> "$CONFIG"
            echo "[all]" >> "$CONFIG"
        fi
    fi
}

apply_eeprom() {
    # Ensure Pi 5 EEPROM has PSU_MAX_CURRENT=5000 and POWER_OFF_ON_HALT=1 (required by Argon ONE V5)
    if command -v rpi-eeprom-config >/dev/null 2>&1; then
        mkdir -p "$STATE_DIR"
        tmp_ee=$(mktemp)
        if [ -f "$STATE_DIR/eeprom.conf" ]; then
            cp "$STATE_DIR/eeprom.conf" "$tmp_ee"
        else
            rpi-eeprom-config 2>/dev/null | tr -d '\r' > "$tmp_ee" || true
        fi
        if [ -s "$tmp_ee" ]; then
            changed=0
            if ! grep -q "^PSU_MAX_CURRENT=" "$tmp_ee"; then
                echo "PSU_MAX_CURRENT=5000" >> "$tmp_ee"
                changed=1
            fi
            if ! grep -q "^POWER_OFF_ON_HALT=" "$tmp_ee"; then
                echo "POWER_OFF_ON_HALT=1" >> "$tmp_ee"
                changed=1
            fi
            if [ "$changed" -eq 1 ]; then
                if rpi-eeprom-config --apply "$tmp_ee" >/dev/null 2>&1; then
                    cp "$tmp_ee" "$STATE_DIR/eeprom.conf"
                    chmod 644 "$STATE_DIR/eeprom.conf"
                fi
            else
                cp "$tmp_ee" "$STATE_DIR/eeprom.conf"
                chmod 644 "$STATE_DIR/eeprom.conf"
            fi
        fi
        rm -f "$tmp_ee"
    fi
}

apply_essentials() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "Error: Please run as root (sudo argon-v5-essential --apply)"
        exit 1
    fi

    if [ -f "$CONFIG" ]; then
        ensure_all_section

        # 1. Front USB 2.0 ports (dwc2 host mode) & USB max current
        if ! has_pi5_param "^[[:space:]]*dtoverlay=dwc2,dr_mode=host([[:space:]]|$)"; then
            echo "dtoverlay=dwc2,dr_mode=host" >> "$CONFIG"
        fi
        if ! has_pi5_param "^[[:space:]]*usb_max_current_enable=1([[:space:]]|$)"; then
            echo "usb_max_current_enable=1" >> "$CONFIG"
        fi

        # 2. UART0 for Argon ONE V5 MCU shutdown / power-cut detection
        if ! has_pi5_param "^[[:space:]]*dtparam=uart0(=on)?([[:space:]]|$)"; then
            echo "dtparam=uart0=on" >> "$CONFIG"
        fi

        # 3. Enable external PCIe slot for Argon ONE V5 M.2 NVMe expansion
        if ! has_pi5_param "^[[:space:]]*dtparam=(nvme|pciex1)(=on)?([[:space:]]|$)"; then
            echo "dtparam=nvme" >> "$CONFIG"
        fi
    fi

    # 4. Pi 5 Bootloader EEPROM (PSU_MAX_CURRENT=5000 & POWER_OFF_ON_HALT=1)
    apply_eeprom

    echo "Argon ONE V5 Case Hardware Essentials (v1.3.0) applied successfully."
}

show_status() {
    echo "========================================================"
    echo " Argon ONE V5 Case Hardware Essentials — Status"
    echo "========================================================"
    echo "Config File : $CONFIG"
    if [ -f "$CONFIG" ]; then
        echo -n "Front USB 2.0 (dwc2)   : "; has_pi5_param "^[[:space:]]*dtoverlay=dwc2,dr_mode=host([[:space:]]|$)" && echo "ENABLED" || echo "NOT SET"
        echo -n "Max USB Current        : "; has_pi5_param "^[[:space:]]*usb_max_current_enable=1([[:space:]]|$)" && echo "ENABLED" || echo "NOT SET"
        echo -n "UART0 Power-Cut Detect : "; has_pi5_param "^[[:space:]]*dtparam=uart0(=on)?([[:space:]]|$)" && echo "ENABLED" || echo "NOT SET"
        echo -n "M.2 NVMe PCIe Slot     : "; has_pi5_param "^[[:space:]]*dtparam=(nvme|pciex1)(=on)?([[:space:]]|$)" && echo "ENABLED" || echo "NOT SET"
    fi
    if [ -f "$STATE_DIR/eeprom.conf" ]; then
        ee_src="$STATE_DIR/eeprom.conf"
    else
        ee_src=$(mktemp)
        rpi-eeprom-config 2>/dev/null | tr -d '\r' > "$ee_src" || true
    fi
    echo -n "Bootloader EEPROM      : "
    ee_items=""
    grep -q "^PSU_MAX_CURRENT=5000" "$ee_src" 2>/dev/null && ee_items="${ee_items}PSU_MAX_CURRENT=5000 " || true
    grep -q "^POWER_OFF_ON_HALT=1" "$ee_src" 2>/dev/null && ee_items="${ee_items}POWER_OFF_ON_HALT=1" || true
    echo "${ee_items:-Default}"
    [ "$ee_src" != "$STATE_DIR/eeprom.conf" ] && rm -f "$ee_src"
    echo "========================================================"
}

case "${1:-}" in
    --apply|apply)
        apply_essentials
        ;;
    --status|status|"")
        show_status
        ;;
    *)
        echo "Usage: argon-v5-essential [--status | --apply]"
        exit 1
        ;;
esac
