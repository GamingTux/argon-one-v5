#!/bin/bash
#
# Argon ONE V5 Case & Performance Essentials (v1.2.0)
# Works on all Argon ONE V5 cases (with or without OLED module) across all Linux distros
#

set -e
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

if [ -e /boot/firmware/config.txt ]; then
    CONFIG="/boot/firmware/config.txt"
else
    CONFIG="/boot/config.txt"
fi

STATE_DIR="/var/lib/argon-v5-essential"

ensure_all_section() {
    # Ensure the last section header in config.txt is [all] so appended lines apply globally
    if [ -f "$CONFIG" ]; then
        last_sec=$(grep "^\[.*\]" "$CONFIG" | tail -n 1 || true)
        if [ "$last_sec" != "[all]" ]; then
            echo "" >> "$CONFIG"
            echo "[all]" >> "$CONFIG"
        fi
    fi
}

apply_irq_and_runtime() {
    # 1. Apply sysctl parameters (explicitly load 99-z-argon-v5-perf.conf last so it always wins)
    sysctl --system >/dev/null 2>&1 || true
    [ -f /etc/sysctl.d/99-z-argon-v5-perf.conf ] && sysctl -p /etc/sysctl.d/99-z-argon-v5-perf.conf >/dev/null 2>&1 || true

    # 2. CPU Governor Optimization:
    #    a) Pre-tune ondemand governor (10ms sampling_rate, 25% up_threshold, 10x down_factor)
    #       in case ondemand is active now or selected later by the user.
    if [ -d /sys/devices/system/cpu/cpufreq/ondemand ]; then
        [ -w /sys/devices/system/cpu/cpufreq/ondemand/sampling_rate ] && echo 10000 > /sys/devices/system/cpu/cpufreq/ondemand/sampling_rate 2>/dev/null || true
        [ -w /sys/devices/system/cpu/cpufreq/ondemand/up_threshold ] && echo 25 > /sys/devices/system/cpu/cpufreq/ondemand/up_threshold 2>/dev/null || true
        [ -w /sys/devices/system/cpu/cpufreq/ondemand/sampling_down_factor ] && echo 10 > /sys/devices/system/cpu/cpufreq/ondemand/sampling_down_factor 2>/dev/null || true
        [ -w /sys/devices/system/cpu/cpufreq/ondemand/io_is_busy ] && echo 1 > /sys/devices/system/cpu/cpufreq/ondemand/io_is_busy 2>/dev/null || true
    fi
    #    b) Switch default CPU governor to schedutil (direct kernel scheduler integration)
    if grep -qw "schedutil" /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors 2>/dev/null; then
        for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
            [ -w "$g" ] && echo schedutil > "$g" 2>/dev/null || true
        done
        [ -w /sys/devices/system/cpu/cpufreq/schedutil/rate_limit_us ] && echo 1000 > /sys/devices/system/cpu/cpufreq/schedutil/rate_limit_us 2>/dev/null || true
    fi

    # 3. PCIe ASPM Performance Mode (eliminates L1 sleep wake-up latency for NVMe + HMB RAM + RP1)
    if [ -w /sys/module/pcie_aspm/parameters/policy ]; then
        echo performance > /sys/module/pcie_aspm/parameters/policy 2>/dev/null || true
    fi

    # 4. Disable Wi-Fi power_save & enable 4-core RPS/RFS on active network interfaces
    for iface in /sys/class/net/wlan*; do
        [ -e "$iface" ] || continue
        ifname=$(basename "$iface")
        /usr/sbin/iw dev "$ifname" set power_save off 2>/dev/null || /sbin/iw dev "$ifname" set power_save off 2>/dev/null || true
    done
    for q in /sys/class/net/eth*/queues/rx-* /sys/class/net/wlan*/queues/rx-* /sys/class/net/end*/queues/rx-*; do
        [ -d "$q" ] || continue
        [ -w "$q/rps_cpus" ] && echo f > "$q/rps_cpus" 2>/dev/null || true
        [ -w "$q/rps_flow_cnt" ] && echo 4096 > "$q/rps_flow_cnt" 2>/dev/null || true
    done

    # 5. Distribute GICv2 Level Hardware Interrupts across CPU1..3 (so CPU0 is not bottlenecked)
    #    - CPU0: RP1 PCIe bridge (eth0, xhci USB3, i2c)
    #    - CPU1: dwc2 (Argon ONE V5 Front USB 2.0 ~8000 IRQs/sec)
    #    - CPU2: v3d (VideoCore VII 3D GPU)
    #    - CPU3: vc4 & mmc (Display Engine, SD Card & Wi-Fi SDIO)
    while IFS=: read -r irq_num rest; do
        irq=$(echo "$irq_num" | tr -d ' ')
        [ -w "/proc/irq/$irq/smp_affinity_list" ] || continue
        case "$rest" in
            *dwc2_hsotg*)
                echo 1 > "/proc/irq/$irq/smp_affinity_list" 2>/dev/null || true
                ;;
            *v3d*)
                echo 2 > "/proc/irq/$irq/smp_affinity_list" 2>/dev/null || true
                ;;
            *"vc4 crtc"*|*107c580000.hvs*|*mmc0*|*mmc1*)
                echo 3 > "/proc/irq/$irq/smp_affinity_list" 2>/dev/null || true
                ;;
        esac
    done < /proc/interrupts
}

configure_irqbalance_policy() {
    # Create policy script so irqbalance leaves our spread Level IRQs on CPU1..3
    # while dynamically balancing all Edge IRQs at core level
    cat << 'EOF' > /usr/bin/argon-v5-irq-policy
#!/bin/sh
IRQ="$2"
if [ -n "$IRQ" ] && [ -d "/proc/irq/$IRQ" ]; then
    for sub in "/proc/irq/$IRQ"/*; do
        name=$(basename "$sub")
        case "$name" in
            *dwc2*|*1000480000.usb*|*v3d*|*vc4*|*107c580000.hvs*|*mmc0*|*mmc1*)
                echo "ban=true"
                exit 0
                ;;
        esac
    done
fi
echo "balance_level=core"
exit 0
EOF
    chmod 755 /usr/bin/argon-v5-irq-policy

    if [ -f /etc/default/irqbalance ]; then
        if ! grep -q "argon-v5-irq-policy" /etc/default/irqbalance; then
            echo 'IRQBALANCE_ARGS="--policyscript=/usr/bin/argon-v5-irq-policy"' >> /etc/default/irqbalance
            systemctl restart irqbalance >/dev/null 2>&1 || true
        fi
    fi
}

configure_zram_lz4() {
    # Switch ZRAM from CPU-heavy zstd to ultra-fast lz4 if zram0 is present and 0B used
    if [ -e /sys/block/zram0/comp_algorithm ]; then
        if ! grep -q "\[lz4\]" /sys/block/zram0/comp_algorithm 2>/dev/null; then
            used_swap=$(awk '$1 == "/dev/zram0" {print $4}' /proc/swaps 2>/dev/null || echo "0")
            if [ "${used_swap:-0}" = "0" ]; then
                systemctl daemon-reload >/dev/null 2>&1 || true
                systemctl restart systemd-zram-setup@zram0.service >/dev/null 2>&1 || true
                systemctl start dev-zram0.swap >/dev/null 2>&1 || true
            fi
        fi
    fi
}

apply_eeprom() {
    # Ensure Pi 5 EEPROM has PSU_MAX_CURRENT=5000, POWER_OFF_ON_HALT=1, and SDRAM_BANKLOW=1
    if command -v rpi-eeprom-config >/dev/null 2>&1; then
        mkdir -p "$STATE_DIR"
        tmp_ee=$(mktemp)
        if [ -f "$STATE_DIR/eeprom.conf" ]; then
            cp "$STATE_DIR/eeprom.conf" "$tmp_ee"
        else
            rpi-eeprom-config 2>/dev/null | tr -d '\r' > "$tmp_ee" || true
        fi
        if [ -s "$tmp_ee" ]; then
            changed=0
            if ! grep -q "^PSU_MAX_CURRENT=" "$tmp_ee"; then
                echo "PSU_MAX_CURRENT=5000" >> "$tmp_ee"
                changed=1
            fi
            if ! grep -q "^POWER_OFF_ON_HALT=" "$tmp_ee"; then
                echo "POWER_OFF_ON_HALT=1" >> "$tmp_ee"
                changed=1
            fi
            if ! grep -q "^SDRAM_BANKLOW=" "$tmp_ee"; then
                echo "SDRAM_BANKLOW=1" >> "$tmp_ee"
                changed=1
            fi
            if [ "$changed" -eq 1 ]; then
                if rpi-eeprom-config --apply "$tmp_ee" >/dev/null 2>&1; then
                    cp "$tmp_ee" "$STATE_DIR/eeprom.conf"
                    chmod 644 "$STATE_DIR/eeprom.conf"
                fi
            else
                cp "$tmp_ee" "$STATE_DIR/eeprom.conf"
                chmod 644 "$STATE_DIR/eeprom.conf"
            fi
        fi
        rm -f "$tmp_ee"
    fi
}

apply_essentials() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "Error: Please run as root (sudo argon-v5-essentials --apply)"
        exit 1
    fi

    if [ -f "$CONFIG" ]; then
        ensure_all_section

        # 1. Front USB 2.0 ports (dwc2 host mode) & USB max current
        if ! grep -q "^dtoverlay=dwc2,dr_mode=host" "$CONFIG"; then
            echo "dtoverlay=dwc2,dr_mode=host" >> "$CONFIG"
        fi
        if ! grep -q "^usb_max_current_enable=1" "$CONFIG"; then
            echo "usb_max_current_enable=1" >> "$CONFIG"
        fi

        # 2. UART0 for Argon ONE V5 MCU shutdown / power-cut detection
        if ! grep -q "^dtparam=uart0=on" "$CONFIG"; then
            echo "dtparam=uart0=on" >> "$CONFIG"
        fi

        # 3. M.2 NVMe slot & PCIe Gen 3 speed
        if ! grep -q "^dtparam=nvme" "$CONFIG"; then
            echo "dtparam=nvme" >> "$CONFIG"
        fi
        if ! grep -q "^dtparam=pciex1_gen=3" "$CONFIG"; then
            echo "dtparam=pciex1_gen=3" >> "$CONFIG"
        fi

        # 4. Safe CPU Boost (2800 MHz, V3D left at standard) if no custom arm_freq is set
        if ! grep -q "^arm_freq=" "$CONFIG"; then
            cat << 'EOF' >> "$CONFIG"

# Argon ONE V5 Safe CPU Boost (2.8 GHz, V3D standard)
arm_freq=2800
EOF
        fi

        # 5. Responsive 4-Stage Pi 5 PWM Fan Curve if no custom fan_temp0 is set
        if ! grep -q "fan_temp0=" "$CONFIG"; then
            cat << 'EOF' >> "$CONFIG"

# Argon ONE V5 Optimized Pi 5 Fan Curve
dtparam=fan_temp0=40000
dtparam=fan_temp0_speed=100
dtparam=fan_temp0_hyst=5000
dtparam=fan_temp1=50000
dtparam=fan_temp1_speed=150
dtparam=fan_temp1_hyst=5000
dtparam=fan_temp2=60000
dtparam=fan_temp2_speed=200
dtparam=fan_temp2_hyst=5000
dtparam=fan_temp3=70000
dtparam=fan_temp3_speed=250
dtparam=fan_temp3_hyst=5000
EOF
        fi
    fi

    # 6. Pi 5 Bootloader EEPROM (PSU_MAX_CURRENT=5000, POWER_OFF_ON_HALT=1, SDRAM_BANKLOW=1)
    apply_eeprom

    # 7. Configure irqbalance policy, ZRAM lz4 & udev rules
    configure_irqbalance_policy
    configure_zram_lz4
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger --subsystem-match=block --subsystem-match=pci --subsystem-match=net 2>/dev/null || true

    # 8. Apply runtime IRQ, RPS/RFS, Wi-Fi, PCIe ASPM, sysctl & CPU governor optimizations
    apply_irq_and_runtime

    echo "Argon ONE V5 Case & Performance Essentials (v1.2.0) applied successfully."
}

show_status() {
    echo "========================================================"
    echo " Argon ONE V5 Case & Performance Essentials — Status"
    echo "========================================================"
    echo "Config File : $CONFIG"
    if [ -f "$CONFIG" ]; then
        echo -n "Front USB 2.0 (dwc2)   : "; grep -q "^dtoverlay=dwc2,dr_mode=host" "$CONFIG" && echo "ENABLED" || echo "NOT SET"
        echo -n "Max USB Current        : "; grep -q "^usb_max_current_enable=1" "$CONFIG" && echo "ENABLED" || echo "NOT SET"
        echo -n "UART0 Power-Cut Detect : "; grep -q "^dtparam=uart0=on" "$CONFIG" && echo "ENABLED" || echo "NOT SET"
        echo -n "NVMe + PCIe Gen 3      : "; grep -q "^dtparam=pciex1_gen=3" "$CONFIG" && echo "ENABLED" || echo "NOT SET"
        cur_arm=$(grep "^arm_freq=" "$CONFIG" | tail -n 1 | cut -d= -f2)
        echo "Configured arm_freq    : ${cur_arm:-Standard (2400)} MHz"
        echo -n "Pi 5 PWM Fan Curve     : "; grep -q "fan_temp0=" "$CONFIG" && echo "CONFIGURED (4-Stage)" || echo "Default OS Curve"
    fi
    if [ -f "$STATE_DIR/eeprom.conf" ]; then
        ee_src="$STATE_DIR/eeprom.conf"
    else
        ee_src=$(mktemp)
        rpi-eeprom-config 2>/dev/null | tr -d '\r' > "$ee_src" || true
    fi
    echo -n "Bootloader EEPROM      : "
    grep -q "^PSU_MAX_CURRENT=5000" "$ee_src" 2>/dev/null && echo -n "5A_PSU " || true
    grep -q "^POWER_OFF_ON_HALT=1" "$ee_src" 2>/dev/null && echo -n "HALT_OFF " || true
    grep -q "^SDRAM_BANKLOW=1" "$ee_src" 2>/dev/null && echo -n "SDRAM_BANKLOW" || true
    echo ""
    [ "$ee_src" != "$STATE_DIR/eeprom.conf" ] && rm -f "$ee_src"
    echo "--------------------------------------------------------"
    gov=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "N/A")
    if [ "$gov" = "schedutil" ]; then
        rate_us=$(cat /sys/devices/system/cpu/cpufreq/schedutil/rate_limit_us 2>/dev/null || echo "N/A")
        echo "CPU Governor           : schedutil (rate_limit=${rate_us}us)"
    else
        up_thr=$(cat /sys/devices/system/cpu/cpufreq/ondemand/up_threshold 2>/dev/null || echo "N/A")
        samp_us=$(cat /sys/devices/system/cpu/cpufreq/ondemand/sampling_rate 2>/dev/null || echo "N/A")
        echo "CPU Governor           : $gov (sampling=${samp_us}us, up_threshold=$up_thr)"
    fi
    aspm=$(cat /sys/module/pcie_aspm/parameters/policy 2>/dev/null || echo "N/A")
    echo "PCIe ASPM Policy       : $aspm"
    if [ -e /sys/block/nvme0n1/queue/scheduler ]; then
        sched=$(cat /sys/block/nvme0n1/queue/scheduler 2>/dev/null)
        ra=$(cat /sys/block/nvme0n1/queue/read_ahead_kb 2>/dev/null)
        echo "NVMe Queue (nvme0n1)   : scheduler=$sched, read_ahead=${ra}KB"
    fi
    zram_alg=$(cat /sys/block/zram0/comp_algorithm 2>/dev/null || echo "N/A")
    echo "ZRAM Compression       : $zram_alg"
    echo "TCP Congestion / Qdisc : $(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null) / $(sysctl -n net.core.default_qdisc 2>/dev/null)"
    echo "Sysctl Memory Tuning   : swappiness=$(sysctl -n vm.swappiness 2>/dev/null), vfs_cache=$(sysctl -n vm.vfs_cache_pressure 2>/dev/null), dirty=$(sysctl -n vm.dirty_ratio 2>/dev/null)%"
    rps_eth=$(cat /sys/class/net/eth0/queues/rx-0/rps_cpus 2>/dev/null || echo "N/A")
    rps_wlan=$(cat /sys/class/net/wlan0/queues/rx-0/rps_cpus 2>/dev/null || echo "N/A")
    echo "4-Core Network RPS     : eth0=0x$rps_eth, wlan0=0x$rps_wlan"
    dwc2_irq=$(awk -F: '/dwc2_hsotg/ {gsub(/ /,"",$1); print $1}' /proc/interrupts)
    v3d_irq=$(awk -F: '/v3d_core0/ {gsub(/ /,"",$1); print $1}' /proc/interrupts)
    vc4_irq=$(awk -F: '/vc4 crtc/ {gsub(/ /,"",$1); print $1; exit}' /proc/interrupts)
    echo "Multi-Core IRQ Spread  : dwc2->CPU$(cat /proc/irq/${dwc2_irq:-0}/effective_affinity_list 2>/dev/null), v3d->CPU$(cat /proc/irq/${v3d_irq:-0}/effective_affinity_list 2>/dev/null), vc4->CPU$(cat /proc/irq/${vc4_irq:-0}/effective_affinity_list 2>/dev/null)"
    echo "========================================================"
}

case "${1:-}" in
    --apply|apply)
        apply_essentials
        ;;
    --apply-runtime)
        apply_irq_and_runtime
        ;;
    --status|status|"")
        show_status
        ;;
    *)
        echo "Usage: argon-v5-essentials [--status | --apply | --apply-runtime]"
        exit 1
        ;;
esac
