#!/usr/bin/env python3
"""
Argon ONE V5 OLED Desktop Monitor & Control Center
Live desktop mirror and comprehensive configuration GUI for Argon ONE V5 OLED display.
"""

import os
import sys
import time
import subprocess
import tkinter as tk
from tkinter import ttk, messagebox

FB_PATH = "/dev/shm/argon_oled_fb.bin"
CONF_PATH = "/etc/argon-v5-oled.conf"

WIDTH = 128
HEIGHT = 64
PIXEL_SIZE = 4
GAP = 1
BORDER_X = 14
BORDER_Y = 14

BG_DARK = "#0d1117"
BG_CARD = "#161b22"
BG_CARD_HOVER = "#21262d"
BORDER_COLOR = "#30363d"
ACCENT_CYAN = "#00e5ff"
ACCENT_BLUE = "#1f6feb"
ACCENT_GREEN = "#238636"
TEXT_PRIMARY = "#f0f6fc"
TEXT_SECONDARY = "#8b949e"
PIXEL_ON = "#00e5ff"
PIXEL_OFF = "#09121c"

BTN_ACTION_MAP_DE = [
    ("Nächste Karte", "next"),
    ("Vorherige Karte", "prev"),
    ("Display an / aus (Standby)", "toggle_sleep"),
    ("Display dimmen / aufhellen", "toggle_dim"),
    ("System herunterfahren (Poweroff)", "shutdown"),
    ("System neu starten (Reboot)", "reboot"),
    ("Keine Aktion (Deaktiviert)", "none"),
]

VARIANT_MAP_DE = {
    "cpu": [
        ("Variante A: Hero Temp, Lüfter & 4-Kerne", "a"),
        ("Variante B: 60s Temperatur-Sparkline", "b"),
        ("Variante C: Split Kacheln & Auslastung", "c"),
    ],
    "mem": [
        ("Variante A: Stacked 126px Progress Bars", "a"),
        ("Variante B: Split Kacheln mit großen %-Zahlen", "b"),
        ("Variante C: Matrix mit USB-Slot", "c"),
    ],
    "net": [
        ("Variante A: Invertierte IP & Traffic-Welle", "a"),
        ("Variante B: Dual RX/TX Sparklines", "b"),
        ("Variante C: Hero Download Traffic Meter", "c"),
    ],
    "clock": [
        ("Variante A: Zentrierte Hero Clock & Uptime", "a"),
        ("Variante B: Gestapelte Retro-Ziffern", "b"),
        ("Variante C: Terminal Banner Dashboard", "c"),
    ],
}

class ArgonOledApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Argon ONE V5 – OLED Control Center & Monitor")
        self.configure(bg=BG_DARK)
        self.resizable(True, True)

        self.last_fb = None
        self.config_data = {}

        self.setup_styles()
        self.build_ui()
        self.load_configuration()

        self.after(50, self.update_display)

    def setup_styles(self):
        style = ttk.Style(self)
        style.theme_use("clam")

        style.configure(".", background=BG_DARK, foreground=TEXT_PRIMARY, font=("sans-serif", 9))
        style.configure("TNotebook", background=BG_DARK, borderwidth=0)
        style.configure("TNotebook.Tab", background=BG_CARD, foreground=TEXT_SECONDARY, padding=[12, 6], font=("sans-serif", 9, "bold"))
        style.map("TNotebook.Tab",
                  background=[("selected", BG_CARD_HOVER), ("active", "#282e39")],
                  foreground=[("selected", ACCENT_CYAN), ("active", TEXT_PRIMARY)])

        style.configure("TFrame", background=BG_DARK)
        style.configure("Card.TFrame", background=BG_CARD, relief="solid", borderwidth=1)
        style.configure("TLabel", background=BG_DARK, foreground=TEXT_PRIMARY)
        style.configure("Card.TLabel", background=BG_CARD, foreground=TEXT_PRIMARY)
        style.configure("Header.TLabel", background=BG_CARD, foreground=ACCENT_CYAN, font=("sans-serif", 10, "bold"))
        style.configure("Sub.TLabel", background=BG_CARD, foreground=TEXT_SECONDARY, font=("sans-serif", 8))

        style.configure("TCheckbutton", background=BG_CARD, foreground=TEXT_PRIMARY, font=("sans-serif", 9))
        style.map("TCheckbutton", background=[("active", BG_CARD)])

        style.configure("TCombobox", fieldbackground=BG_DARK, background=BG_CARD_HOVER, foreground=TEXT_PRIMARY)

    def build_ui(self):
        main_container = tk.Frame(self, bg=BG_DARK)
        main_container.pack(fill=tk.BOTH, expand=True, padx=12, pady=10)

        # ---------------- TOP: OLED MIRROR CANVAS ----------------
        preview_box = tk.LabelFrame(main_container, text=" LIVE HARDWARE OLED SPIEGEL ", font=("sans-serif", 9, "bold"),
                                   bg=BG_CARD, fg=ACCENT_CYAN, bd=1, relief=tk.SOLID)
        preview_box.pack(fill=tk.X, pady=(0, 8), padx=2)

        win_w = WIDTH * (PIXEL_SIZE + GAP) + BORDER_X * 2
        canvas_h = HEIGHT * (PIXEL_SIZE + GAP) + BORDER_Y * 2

        self.canvas = tk.Canvas(
            preview_box,
            width=win_w,
            height=canvas_h,
            bg=BG_DARK,
            highlightthickness=0
        )
        self.canvas.pack(pady=6)

        # Bezel around active OLED area
        bx0 = BORDER_X - 5
        by0 = BORDER_Y - 5
        bx1 = win_w - BORDER_X + 5
        by1 = BORDER_Y + HEIGHT * (PIXEL_SIZE + GAP) + 5
        self.canvas.create_rectangle(bx0, by0, bx1, by1, outline="#2b313d", width=2, fill="#04070b")

        # Pixel Grid
        self.pixels = []
        for y in range(HEIGHT):
            row = []
            py = BORDER_Y + y * (PIXEL_SIZE + GAP)
            for x in range(WIDTH):
                px = BORDER_X + x * (PIXEL_SIZE + GAP)
                rect_id = self.canvas.create_rectangle(
                    px, py, px + PIXEL_SIZE, py + PIXEL_SIZE,
                    fill=PIXEL_OFF, outline=""
                )
                row.append(rect_id)
            self.pixels.append(row)

        # Controls under mirror
        ctrl_bar = tk.Frame(preview_box, bg=BG_CARD)
        ctrl_bar.pack(fill=tk.X, padx=10, pady=(2, 8))

        btn_style = {"bg": "#21262d", "fg": TEXT_PRIMARY, "activebackground": "#30363d",
                     "activeforeground": "#ffffff", "bd": 0, "padx": 10, "pady": 4, "cursor": "hand2"}

        tk.Button(ctrl_bar, text="◀ Zurück", font=("sans-serif", 9, "bold"),
                  command=self.prev_screen, **btn_style).pack(side=tk.LEFT, padx=3)

        self.hw_btn = tk.Button(ctrl_bar, text="● HW Taste (Klick)", font=("sans-serif", 9, "bold"),
                                bg=ACCENT_BLUE, fg="#ffffff", activebackground="#1158c7",
                                bd=0, padx=14, pady=4, cursor="hand2", command=self.next_screen)
        self.hw_btn.pack(side=tk.LEFT, expand=True, fill=tk.X, padx=4)

        tk.Button(ctrl_bar, text="Weiter ▶", font=("sans-serif", 9, "bold"),
                  command=self.next_screen, **btn_style).pack(side=tk.LEFT, padx=3)

        tk.Button(ctrl_bar, text="⚡ Standby", font=("sans-serif", 9),
                  command=self.toggle_power, **btn_style).pack(side=tk.LEFT, padx=3)

        tk.Button(ctrl_bar, text="🔆 Dimmen", font=("sans-serif", 9),
                  command=self.toggle_dim, **btn_style).pack(side=tk.LEFT, padx=3)

        # Quick Jump Pills
        jump_bar = tk.Frame(preview_box, bg=BG_CARD)
        jump_bar.pack(fill=tk.X, padx=10, pady=(0, 6))
        for idx, lbl in enumerate(["[1] CPU & Thermik", "[2] Speicher & RAM", "[3] Netzwerk", "[4] Uhr & Heute"]):
            tk.Button(jump_bar, text=lbl, font=("sans-serif", 8), bg="#1c2128", fg=TEXT_SECONDARY,
                      activebackground="#30363d", activeforeground=ACCENT_CYAN, bd=0, padx=6, pady=2,
                      cursor="hand2", command=lambda s=idx: self.set_screen(s)).pack(side=tk.LEFT, expand=True, fill=tk.X, padx=2)

        # ---------------- BOTTOM: SETTINGS NOTEBOOK / PANELS ----------------
        self.notebook = ttk.Notebook(main_container)
        self.notebook.pack(fill=tk.BOTH, expand=True, pady=(4, 0))

        tab_auto = ttk.Frame(self.notebook)
        tab_buttons = ttk.Frame(self.notebook)
        tab_bright = ttk.Frame(self.notebook)
        tab_variants = ttk.Frame(self.notebook)

        self.notebook.add(tab_auto, text=" Automat. Wechsel & Schoner ")
        self.notebook.add(tab_buttons, text=" Hardware-Taste ")
        self.notebook.add(tab_bright, text=" Helligkeit & Dimmen ")
        self.notebook.add(tab_variants, text=" Karten-Designs ")

        self.build_tab_auto(tab_auto)
        self.build_tab_buttons(tab_buttons)
        self.build_tab_bright(tab_bright)
        self.build_tab_variants(tab_variants)

        # Bottom Action & Status Footer
        footer = tk.Frame(main_container, bg=BG_DARK)
        footer.pack(fill=tk.X, pady=(8, 0))

        self.status_lbl = tk.Label(footer, text="Bereit.", font=("sans-serif", 9), bg=BG_DARK, fg=TEXT_SECONDARY, anchor="w")
        self.status_lbl.pack(side=tk.LEFT, fill=tk.X, expand=True)

        tk.Button(footer, text="🎨 Kachel-Designer", font=("sans-serif", 9, "bold"),
                  bg=ACCENT_BLUE, fg="#ffffff", activebackground="#1158c7", bd=0, padx=12, pady=4,
                  cursor="hand2", command=self.open_card_builder).pack(side=tk.RIGHT, padx=6)

        tk.Button(footer, text="🔄 Neu laden", font=("sans-serif", 9), bg="#21262d", fg=TEXT_PRIMARY,
                  activebackground="#30363d", bd=0, padx=10, pady=4, cursor="hand2", command=self.load_configuration).pack(side=tk.RIGHT, padx=4)

        tk.Button(footer, text="💾 Einstellungen anwenden & speichern", font=("sans-serif", 9, "bold"),
                  bg=ACCENT_GREEN, fg="#ffffff", activebackground="#2ea043", bd=0, padx=16, pady=4,
                  cursor="hand2", command=self.save_configuration).pack(side=tk.RIGHT, padx=4)

        # Keybindings
        self.canvas.bind("<Button-1>", lambda e: self.next_screen())
        self.canvas.bind("<Button-3>", lambda e: self.prev_screen())
        self.bind("<space>", lambda e: self.next_screen())
        self.bind("<Right>", lambda e: self.next_screen())
        self.bind("<Left>", lambda e: self.prev_screen())
        self.bind("t", lambda e: self.toggle_power())
        self.bind("d", lambda e: self.toggle_dim())
        self.bind("q", lambda e: self.destroy())
        self.bind("<Escape>", lambda e: self.destroy())
        for i in range(4):
            self.bind(str(i + 1), lambda e, idx=i: self.set_screen(idx))

