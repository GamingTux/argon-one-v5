    def build_tab_variants(self, parent):
        box = tk.LabelFrame(parent, text=" Kartendesign-Auswahl (Varianten A / B / C) ", bg=BG_CARD, fg=TEXT_PRIMARY, bd=1, relief=tk.SOLID)
        box.pack(fill=tk.X, padx=6, pady=6)

        self.cb_variants = {}
        for target, title in [("cpu", "1. CPU & Thermik:"), ("mem", "2. Speicher & RAM:"),
