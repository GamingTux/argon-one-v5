    def on_cycle_toggle(self):
        state = tk.NORMAL if self.var_cycle_enable.get() else tk.DISABLED
        self.scale_cycle.configure(state=state)
        self.update_cycle_label(self.scale_cycle.get())

    def update_cycle_label(self, val):
        if not self.var_cycle_enable.get():
            self.lbl_cycle_val.configure(text="Deaktiviert (Nur manuelle Umschaltung per Taste)", fg=TEXT_SECONDARY)
        else:
            self.lbl_cycle_val.configure(text=f"{val} Sekunden pro Karte", fg=ACCENT_CYAN)

    def on_saver_toggle(self):
        state = tk.NORMAL if self.var_saver_enable.get() else tk.DISABLED
        self.scale_saver.configure(state=state)
        self.update_saver_label(self.scale_saver.get())

    def update_saver_label(self, val):
        if not self.var_saver_enable.get():
            self.lbl_saver_val.configure(text="Deaktiviert (Display bleibt dauerhaft aktiv)", fg=TEXT_SECONDARY)
        else:
            mins = int(val) // 60
            secs = int(val) % 60
            time_str = f"{mins}m {secs}s" if mins > 0 else f"{secs}s"
            self.lbl_saver_val.configure(text=f"{val} Sekunden ({time_str})", fg=ACCENT_CYAN)

