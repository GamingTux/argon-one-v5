        box1 = tk.LabelFrame(parent, text=" Automatischer Kachelwechsel (Auto-Cycle) ", bg=BG_CARD, fg=TEXT_PRIMARY, bd=1, relief=tk.SOLID)
        box1.pack(fill=tk.X, padx=6, pady=6)

        self.var_cycle_enable = tk.BooleanVar(value=False)
        cb1 = ttk.Checkbutton(box1, text="Kacheln automatisch durchwechseln", variable=self.var_cycle_enable, command=self.on_cycle_toggle)
        cb1.pack(anchor="w", padx=12, pady=(8, 4))

        f_dur = tk.Frame(box1, bg=BG_CARD)
        f_dur.pack(fill=tk.X, padx=12, pady=(0, 10))

        self.lbl_cycle_val = tk.Label(f_dur, text="10 Sekunden pro Karte", bg=BG_CARD, fg=ACCENT_CYAN, font=("sans-serif", 9, "bold"))
        self.lbl_cycle_val.pack(anchor="w")

        self.scale_cycle = tk.Scale(f_dur, from_=3, to=60, orient=tk.HORIZONTAL, bg=BG_CARD, fg=TEXT_PRIMARY,
                                    highlightthickness=0, troughcolor="#21262d", command=self.update_cycle_label)
        self.scale_cycle.set(10)
        self.scale_cycle.pack(fill=tk.X)

        box2 = tk.LabelFrame(parent, text=" Bildschirmschoner (Screensaver & Anti-Burn-In) ", bg=BG_CARD, fg=TEXT_PRIMARY, bd=1, relief=tk.SOLID)
        box2.pack(fill=tk.X, padx=6, pady=6)

        self.var_saver_enable = tk.BooleanVar(value=False)
