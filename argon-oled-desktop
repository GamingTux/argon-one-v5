        cb2.pack(anchor="w", padx=12, pady=(8, 4))

        f_sav = tk.Frame(box2, bg=BG_CARD)
        f_sav.pack(fill=tk.X, padx=12, pady=(0, 8))

        self.lbl_saver_val = tk.Label(f_sav, text="120 Sekunden (2 Minuten)", bg=BG_CARD, fg=ACCENT_CYAN, font=("sans-serif", 9, "bold"))
        self.lbl_saver_val.pack(anchor="w")

        self.scale_saver = tk.Scale(f_sav, from_=15, to=600, orient=tk.HORIZONTAL, bg=BG_CARD, fg=TEXT_PRIMARY,
                                    highlightthickness=0, troughcolor="#21262d", command=self.update_saver_label)
        self.scale_saver.set(120)
        self.scale_saver.pack(fill=tk.X)

        tk.Label(box2, text="Hinweis: Ein Druck auf die Hardware-Taste oder eine Überhitzung weckt das OLED sofort auf.",
