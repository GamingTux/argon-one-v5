            cb = ttk.Combobox(f, state="readonly", values=items, width=38)
            cb.current(0)
            cb.pack(side=tk.LEFT, fill=tk.X, expand=True)
            self.cb_variants[target] = cb

    def load_configuration(self):
        conf = {}
        if os.path.exists(CONF_PATH):
            try:
                with open(CONF_PATH, "r") as f:
                    for line in f:
                        line = line.strip()
                        if line.startswith("#") or not line or "=" not in line:
                            continue
                        k, v = line.split("=", 1)
                        conf[k.strip().lower()] = v.strip().lower()
            except Exception as e:
                self.status_lbl.configure(text=f"Fehler beim Lesen der Konfigurationsdatei: {e}", fg="#f85149")
                return

        # 1. Screen Duration
        dur = int(conf.get("screen_duration", "0"))
        if dur > 0:
            self.var_cycle_enable.set(True)
            self.scale_cycle.set(dur)
        else:
            self.var_cycle_enable.set(False)
            self.scale_cycle.set(10)
        self.on_cycle_toggle()

        # 2. Screensaver
        saver = int(conf.get("screensaver_timeout", "0"))
        if saver > 0:
            self.var_saver_enable.set(True)
            self.scale_saver.set(saver)
        else:
            self.var_saver_enable.set(False)
            self.scale_saver.set(120)
        self.on_saver_toggle()

        # 3. Brightness
        b = int(conf.get("brightness", "200"))
        db = int(conf.get("dim_brightness", "25"))
        self.scale_bright.set(b)
        self.scale_dim.set(db)
        self.update_bright_label(b)
        self.update_dim_label(db)

        # 4. Button actions
        btn_s = conf.get("btn_action_short", "next")
        btn_l = conf.get("btn_action_long", "toggle_sleep")

        for idx, (_, val) in enumerate(BTN_ACTION_MAP_DE):
            if val == btn_s: self.cb_btn_short.current(idx)
            if val == btn_l: self.cb_btn_long.current(idx)

        # 5. Variants
        for target in ["cpu", "mem", "net", "clock"]:
            v = conf.get(f"variant_{target}", "a")
            items = VARIANT_MAP_DE[target]
            for idx, (_, code) in enumerate(items):
                if code == v:
                    self.cb_variants[target].current(idx)
                    break

        self.status_lbl.configure(text=f"Konfiguration geladen aus {CONF_PATH}", fg=TEXT_SECONDARY)

    def save_configuration(self):
        try:
            # 1. Screen duration
            dur = self.scale_cycle.get() if self.var_cycle_enable.get() else 0
            subprocess.run(["argon-oled", "set", "screen_duration", str(dur)], check=True)

            # 2. Screensaver timeout
            sav = self.scale_saver.get() if self.var_saver_enable.get() else 0
            subprocess.run(["argon-oled", "set", "screensaver_timeout", str(sav)], check=True)

            # 3. Brightness
            b = self.scale_bright.get()
            db = self.scale_dim.get()
            subprocess.run(["argon-oled", "set", "brightness", str(b)], check=True)
            subprocess.run(["argon-oled", "set", "dim_brightness", str(db)], check=True)

            # 4. Button actions
            idx_s = self.cb_btn_short.current()
            act_s = BTN_ACTION_MAP_DE[idx_s][1]
            subprocess.run(["argon-oled", "set", "btn_action_short", act_s], check=True)

            idx_l = self.cb_btn_long.current()
            act_l = BTN_ACTION_MAP_DE[idx_l][1]
            subprocess.run(["argon-oled", "set", "btn_action_long", act_l], check=True)

            # 5. Variants
            for target in ["cpu", "mem", "net", "clock"]:
                v_idx = self.cb_variants[target].current()
                v_code = VARIANT_MAP_DE[target][v_idx][1]
                subprocess.run(["argon-oled", "variant", target, v_code], check=True)

            self.status_lbl.configure(text="✓ Einstellungen erfolgreich im Dienst gespeichert & angewendet!", fg="#3fb950")
        except Exception as e:
            self.status_lbl.configure(text=f"Fehler beim Speichern: {e}", fg="#f85149")
            messagebox.showerror("Fehler", f"Konnte Einstellungen nicht speichern:\n{e}")

    def next_screen(self):
        subprocess.run(["argon-oled", "next"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def prev_screen(self):
        subprocess.run(["argon-oled", "prev"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def toggle_power(self):
        subprocess.run(["argon-oled", "toggle"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def toggle_dim(self):
        subprocess.run(["argon-oled", "dim"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def set_screen(self, idx):
        subprocess.run(["argon-oled", "screen", str(idx)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def open_card_builder(self):
        script = os.path.join(os.path.dirname(os.path.abspath(__file__)), "argon_card_builder.py")
        subprocess.Popen([sys.executable, script])

    def update_display(self):
        try:
            if os.path.exists(FB_PATH):
                with open(FB_PATH, "rb") as f:
                    fb = f.read()

                if len(fb) >= 1024 and fb != self.last_fb:
                    for y in range(HEIGHT):
                        page = y // 8
                        bit = y % 8
                        for x in range(WIDTH):
                            byte_val = fb[page * WIDTH + x]
                            is_on = (byte_val & (1 << bit)) != 0
                            old_on = False
                            if self.last_fb is not None and len(self.last_fb) >= 1024:
                                old_on = (self.last_fb[page * WIDTH + x] & (1 << bit)) != 0
                            if self.last_fb is None or is_on != old_on:
                                color = PIXEL_ON if is_on else PIXEL_OFF
                                self.canvas.itemconfig(self.pixels[y][x], fill=color)

                    self.last_fb = fb
        except Exception:
            pass

        self.after(100, self.update_display)

